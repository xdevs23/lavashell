{
  "schema": 1,
  "profile": "packaged",
  "target": "x86_64-unknown-linux-gnu",
  "projectionDirectory": "nix/cargo-projections",
  "engineRoot": "bevy",
  "frameworkRoot": "lavashell-core",
  "nativeDirectory": "examples/support",
  "layers": ["engine", "registry"],
  "companions": ["lavashell-renderer", "lavashell-vulkan-renderer"],
  "packagedCrates": {
    "aosp-round-trip": "tools/aosp-round-trip",
    "wayland-input": "tools/wayland-input",
    "native-harness": "tools/native-harness",
    "source-rules": "tools/source-rules",
    "repository-hooks": "tools/repository-hooks",
    "bevy": "crates/lavashell-bevy",
    "test-platform": "crates/lavashell-test-platform",
    "recordings": "examples/recordings"
  },
  "sourceFiles": {
    "everyPackage": ["COPYING"],
    "byMember": {
      "tools/native-harness": ["nix/app-declarations.json"]
    }
  },
  "stub": {
    "version": "0.0.0",
    "library": "src/lib.rs",
    "buildScript": "build.rs",
    "mainSource": "fn main() {}",
    "librarySource": ""
  }
}
