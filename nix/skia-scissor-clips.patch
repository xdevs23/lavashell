+// Unlike GrFixedClip, it scissors draws inside it too, as antialiasing reaches past their bounds.
+class PixelClip final : public GrHardClip {
+public:
+    explicit PixelClip(const SkIRect& pixels) : fPixels(pixels) {}
+
+    SkIRect getConservativeBounds() const override { return fPixels; }
+
+    Effect apply(GrAppliedHardClip* out, SkIRect* bounds) const override {
+        if (!bounds->intersect(fPixels)) {
+            return Effect::kClippedOut;
+        }
+        out->setScissor(fPixels);
+        return Effect::kClipped;
+    }
+
+private:
+    SkIRect fPixels;
+};
