+GrClip::PreClipResult ClipStack::preApplyScissored(const SaveRecord& current) const {
+    // The one element that is not a scissor is reported as if it were the only element, limited
+    // to the pixels of the scissors.
+    if (current.shader()) {
+        return GrClip::Effect::kClipped;
+    }
+    const RawElement* only = nullptr;
+    SkIRect scissor = fDeviceBounds;
+    int i = fElements.count();
+    for (const RawElement& e : fElements.ritems()) {
+        --i;
+        if (i < current.oldestElementIndex()) {
+            break;
+        } else if (e.isInvalid()) {
+            continue;
+        } else if (e.isScissor()) {
+            if (!scissor.intersect(e.outerBounds())) {
+                return GrClip::Effect::kClippedOut;
+            }
+        } else if (!only) {
+            only = &e;
+        } else {
+            return GrClip::Effect::kClipped;
+        }
+    }
+    if (only && only->clipType() == ClipState::kDeviceRect) {
+        SkRect rect = only->shape().rect();
+        if (!rect.intersect(SkRect::Make(scissor))) {
+            return GrClip::Effect::kClippedOut;
+        }
+        return {rect, only->aa()};
+    } else if (only && only->clipType() == ClipState::kDeviceRRect) {
+        return GrClip::ScissoredRRect{only->shape().rrect(), only->aa(), scissor};
+    }
+    return GrClip::Effect::kClipped;
+}
