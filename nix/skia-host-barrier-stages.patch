 using namespace skia_private;
 
+// A barrier on host access needs the host stage, which ALL_COMMANDS for the GENERAL layout does not include.
+static VkPipelineStageFlags with_host_stage(VkPipelineStageFlags stages, VkAccessFlags access) {
+    constexpr VkAccessFlags kHostAccess = VK_ACCESS_HOST_READ_BIT | VK_ACCESS_HOST_WRITE_BIT;
+    return (access & kHostAccess) ? (stages | VK_PIPELINE_STAGE_HOST_BIT) : stages;
+}
