-/** Used to pick vertex attribute types. */
-static inline bool SkPMColor4fFitsInBytes(const SkPMColor4f& color) {
-    // Might want to instead check that the components are [0...a] instead of [0...1]?
-    return color.fitsInBytes();
+/** Used to pick vertex attribute types. A target with float channels gets every color in
+    floats, so that the color it stores does not depend on the other draws in the same op. */
+static inline bool SkPMColor4fFitsInBytes(const SkPMColor4f& color, GrClampType clampType) {
+    return clampType == GrClampType::kAuto && color.fitsInBytes();
+}
+
+/** Rounds a color to the precision of a target with half float channels and returns other colors
+    unchanged. A driver may round a color into such a target differently when it clears it than
+    when it draws it, but stores a color that the target holds exactly the same either way. */
+static inline SkPMColor4f SkPMColor4fRoundForTarget(const SkPMColor4f& color,
+                                                    GrColorType colorType) {
+    GrColorFormatDesc desc = GrGetColorTypeDesc(colorType);
+    if (desc.encoding() != GrColorTypeEncoding::kFloat || (desc.r() != 16 && desc.a() != 16)) {
+        return color;
+    }
+    SkPMColor4f rounded;
+    skvx::from_half(skvx::to_half(skvx::float4::Load(color.vec()))).store(rounded.vec());
+    return rounded;
 }
 
